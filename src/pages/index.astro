---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="AI-Powered Landing Pages">
  <div class="min-h-screen bg-gradient-to-br from-primary-50 via-white to-primary-50">
    <!-- Navigation -->
    <nav class="container mx-auto px-6 py-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <div class="w-10 h-10 bg-primary-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-xl">L</span>
          </div>
          <span class="text-2xl font-bold text-gray-900">LandingForge</span>
        </div>
        <div class="hidden md:flex items-center space-x-8">
          <a href="#features" class="text-gray-600 hover:text-gray-900">Features</a>
          <a href="#pricing" class="text-gray-600 hover:text-gray-900">Pricing</a>
          <a href="/login" class="text-gray-600 hover:text-gray-900">Login</a>
          <a href="/signup" class="btn-primary">Get Started</a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="container mx-auto px-6 py-20 text-center">
      <h1 class="text-6xl font-bold text-gray-900 mb-6 leading-tight">
        Create Beautiful<br />
        <span class="text-primary-600">Landing Pages</span><br />
        in Minutes with AI
      </h1>
      <p class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto">
        No coding required. Just describe your product, and our AI will help you create a stunning landing page that converts.
      </p>
      <div class="flex items-center justify-center space-x-4">
        <a href="/signup" class="btn-primary text-lg px-8 py-4">
          Start Building for Free
        </a>
        <a href="#demo" class="btn-secondary text-lg px-8 py-4">
          Watch Demo
        </a>
      </div>
      <p class="text-sm text-gray-500 mt-4">No credit card required • Free tier available</p>
    </section>

    <!-- Features Section -->
    <section id="features" class="container mx-auto px-6 py-20">
      <h2 class="text-4xl font-bold text-center mb-16">Everything You Need</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">AI-Powered</h3>
          <p class="text-gray-600">Let AI write your headlines, copy, and suggest improvements. Get professional copy in seconds.</p>
        </div>

        <div class="card">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Beautiful Templates</h3>
          <p class="text-gray-600">Choose from professionally designed templates. Customize colors, images, and content easily.</p>
        </div>

        <div class="card">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Instant Deploy</h3>
          <p class="text-gray-600">Your landing page goes live instantly. Get a free subdomain or use your own custom domain.</p>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="container mx-auto px-6 py-20">
      <h2 class="text-4xl font-bold text-center mb-4">Simple, Transparent Pricing</h2>
      <p class="text-gray-600 text-center mb-16">Start free, upgrade when you grow</p>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Free Tier -->
        <div class="card">
          <h3 class="text-2xl font-bold mb-2">Free</h3>
          <div class="mb-6">
            <span class="text-4xl font-bold">$0</span>
            <span class="text-gray-600">/month</span>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">1 landing page</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">All templates</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">10 AI generations/month</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Subdomain hosting</span>
            </li>
          </ul>
          <a href="/signup" class="btn-secondary w-full text-center block">Get Started</a>
        </div>

        <!-- Pro Tier -->
        <div class="card border-2 border-primary-500 relative">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary-500 text-white px-4 py-1 rounded-full text-sm font-semibold">
            Most Popular
          </div>
          <h3 class="text-2xl font-bold mb-2">Pro</h3>
          <div class="mb-6">
            <span class="text-4xl font-bold">$29</span>
            <span class="text-gray-600">/month</span>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">5 landing pages</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Remove watermark</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Unlimited AI generations</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Basic analytics</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Email support</span>
            </li>
          </ul>
          <a href="/signup" class="btn-primary w-full text-center block">Start Pro Trial</a>
        </div>

        <!-- Business Tier -->
        <div class="card">
          <h3 class="text-2xl font-bold mb-2">Business</h3>
          <div class="mb-6">
            <span class="text-4xl font-bold">$79</span>
            <span class="text-gray-600">/month</span>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">20 landing pages</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Custom domains</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Advanced analytics</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Priority support</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">API access</span>
            </li>
          </ul>
          <a href="/signup" class="btn-secondary w-full text-center block">Contact Sales</a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="container mx-auto px-6 py-20">
      <div class="bg-primary-600 rounded-3xl p-12 text-center">
        <h2 class="text-4xl font-bold text-white mb-4">Ready to Launch Your Landing Page?</h2>
        <p class="text-primary-100 text-lg mb-8 max-w-2xl mx-auto">
          Join hundreds of creators who are building beautiful landing pages with AI
        </p>
        <a href="/signup" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold text-lg hover:bg-gray-100 transition-colors inline-block">
          Get Started for Free
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="container mx-auto px-6 py-12 border-t border-gray-200">
      <div class="text-center text-gray-600">
        <p>&copy; 2026 LandingForge. All rights reserved.</p>
        <div class="mt-4 space-x-6">
          <a href="#" class="hover:text-gray-900">Privacy</a>
          <a href="#" class="hover:text-gray-900">Terms</a>
          <a href="#" class="hover:text-gray-900">Contact</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
