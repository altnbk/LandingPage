---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Reset Password">
  <div class="min-h-screen bg-gradient-to-br from-primary-50 via-white to-primary-50 flex items-center justify-center px-4">
    <div class="max-w-md w-full">
      <!-- Logo -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center space-x-2 mb-4">
          <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-2xl">L</span>
          </div>
          <span class="text-3xl font-bold text-gray-900">LandingForge</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Reset your password</h1>
        <p class="text-gray-600 mt-2">Enter your email to receive a reset link</p>
      </div>

      <!-- Reset Form Card -->
      <div class="bg-white rounded-xl shadow-lg p-8">
        <div id="alert-container"></div>

        <form id="reset-form" class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="input"
              placeholder="you@example.com"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="btn-primary w-full mt-6"
          >
            Send Reset Link
          </button>
        </form>

        <div class="mt-6 text-center text-sm text-gray-600">
          Remember your password?
          <a href="/login" class="text-primary-600 font-semibold hover:text-primary-700">
            Log in
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('reset-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const alertContainer = document.getElementById('alert-container') as HTMLDivElement;

  function showAlert(message: string, type: 'success' | 'error') {
    const alertClass = type === 'success'
      ? 'bg-green-50 border-green-200 text-green-800'
      : 'bg-red-50 border-red-200 text-red-800';

    const icon = type === 'success' ? '✓' : '✕';

    alertContainer.innerHTML = `
      <div class="border rounded-lg p-4 mb-4 ${alertClass}">
        <div class="flex items-start">
          <span class="mr-2 font-bold">${icon}</span>
          <div>${message}</div>
        </div>
      </div>
    `;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const email = formData.get('email') as string;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    try {
      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/update-password`,
      });

      if (error) throw error;

      showAlert(
        'Password reset link sent! Please check your email.',
        'success'
      );
      form.reset();
    } catch (error: any) {
      showAlert(
        error.message || 'Failed to send reset link. Please try again.',
        'error'
      );
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Reset Link';
    }
  });
</script>
