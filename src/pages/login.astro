---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Login">
  <div class="min-h-screen bg-gradient-to-br from-primary-50 via-white to-primary-50 flex items-center justify-center px-4">
    <div class="max-w-md w-full">
      <!-- Logo -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center space-x-2 mb-4">
          <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-2xl">L</span>
          </div>
          <span class="text-3xl font-bold text-gray-900">LandingForge</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Welcome back</h1>
        <p class="text-gray-600 mt-2">Log in to your account</p>
      </div>

      <!-- Login Form Card -->
      <div class="bg-white rounded-xl shadow-lg p-8">
        <div id="alert-container"></div>

        <form id="login-form" class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="input"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
              Password <span class="text-red-500">*</span>
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              class="input"
              placeholder="Enter your password"
            />
          </div>

          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center">
              <input type="checkbox" name="remember" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500">
              <span class="ml-2 text-gray-600">Remember me</span>
            </label>
            <a href="/reset-password" class="text-primary-600 hover:text-primary-700 font-medium">
              Forgot password?
            </a>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="btn-primary w-full mt-6"
          >
            Log In
          </button>
        </form>

        <div class="mt-6 text-center text-sm text-gray-600">
          Don't have an account?
          <a href="/signup" class="text-primary-600 font-semibold hover:text-primary-700">
            Sign up
          </a>
        </div>
      </div>

      <!-- Back to home -->
      <div class="text-center mt-6">
        <a href="/" class="text-sm text-gray-600 hover:text-gray-900">
          ← Back to home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const alertContainer = document.getElementById('alert-container') as HTMLDivElement;

  function showAlert(message: string, type: 'success' | 'error') {
    const alertClass = type === 'success'
      ? 'bg-green-50 border-green-200 text-green-800'
      : 'bg-red-50 border-red-200 text-red-800';

    const icon = type === 'success' ? '✓' : '✕';

    alertContainer.innerHTML = `
      <div class="border rounded-lg p-4 mb-4 ${alertClass}">
        <div class="flex items-start">
          <span class="mr-2 font-bold">${icon}</span>
          <div>${message}</div>
        </div>
      </div>
    `;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    // Disable button and show loading state
    submitBtn.disabled = true;
    submitBtn.textContent = 'Logging in...';

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) throw error;

      if (data.user) {
        showAlert('Login successful! Redirecting...', 'success');

        // Redirect to dashboard
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 1000);
      }
    } catch (error: any) {
      showAlert(
        error.message || 'Failed to log in. Please check your credentials.',
        'error'
      );
      submitBtn.disabled = false;
      submitBtn.textContent = 'Log In';
    }
  });
</script>
